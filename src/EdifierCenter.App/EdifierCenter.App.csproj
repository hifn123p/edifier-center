<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EdifierCenter</AssemblyName>
    <RootNamespace>EdifierCenter.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EdifierCenter.Core\EdifierCenter.Core.csproj" />
    <ProjectReference Include="..\EdifierCenter.Ble\EdifierCenter.Ble.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 可移植布局：配置/日志/诊断均落在 exe 运行目录（docs/03 §8） -->
    <EmbeddedResource Include="..\..\profiles\mr5.json" LogicalName="mr5.json" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
