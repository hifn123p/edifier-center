<Window x:Class="EdifierCenter.App.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edifier Center"
        Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Border CornerRadius="10" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
            Padding="16,12,16,14">
        <StackPanel>

            <!-- 断线横幅 -->
            <Border Visibility="{Binding BannerVisibility}" Background="{DynamicResource Card2Brush}"
                    CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                <TextBlock Text="音箱未连接 · 自动重连中…" FontSize="12"
                           Foreground="{DynamicResource Text2Brush}"/>
            </Border>

            <!-- 头部 -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <!-- 应用图标微缩（应用图标微缩版） -->
                    <Border Width="34" Height="34" CornerRadius="8" Background="#15171B">
                        <Canvas Width="34" Height="34">
                            <Ellipse Canvas.Left="12" Canvas.Top="6" Width="10" Height="10"
                                     Fill="#C07A45" Stroke="#191B1F" StrokeThickness="2.5"/>
                            <Ellipse Canvas.Left="8" Canvas.Top="17" Width="18" Height="18"
                                     Fill="#C07A45" Stroke="#191B1F" StrokeThickness="3"/>
                            <Ellipse Canvas.Left="14" Canvas.Top="23" Width="6" Height="6" Fill="#1B1D21"/>
                        </Canvas>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding SignalLine}" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Text2Brush}"/>
                    </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="999" Padding="9,3" Background="{DynamicResource PillOffBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource PillOffBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PillBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"/>
                </Border>
            </Grid>

            <!-- 主体（断开时整体禁用） -->
            <StackPanel Margin="0,10,0,0" IsEnabled="{Binding IsConnected}">

                <!-- 输入源 + 解码徽章 -->
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource Card2Brush}" CornerRadius="999" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="输入源" FontSize="11.5" Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Text="{Binding InputLabel}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Card2Brush}" CornerRadius="999" Padding="10,4"
                            Margin="8,0,0,0" Visibility="{Binding DecodeVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="解码" FontSize="11.5" Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Text="{Binding DecodeLabel}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarnBrush}" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 音量 -->
                <Grid Margin="0,14,0,0">
                    <TextBlock Text="音量" FontSize="12" Foreground="{DynamicResource Text2Brush}"/>
                    <TextBlock Text="{Binding VolumeText}" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource Text2Brush}"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Content="{Binding MuteButtonText}"
                            MinWidth="60" Command="{Binding MuteToggleCommand}" VerticalAlignment="Center"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource HSlider}"
                            Minimum="0" Maximum="{Binding VolumeMax}" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding Volume, Mode=OneWay}"
                            Margin="10,0,0,0"/>
                </Grid>

                <!-- 声音模式 -->
                <TextBlock Text="声音模式" FontSize="12" Foreground="{DynamicResource Text2Brush}" Margin="0,14,0,6"/>
                <ListBox Style="{StaticResource SegmentListBox}" ItemsSource="{Binding SoundModes}"
                         DisplayMemberPath="Label" SelectedItem="{Binding SelectedSoundMode, Mode=TwoWay}"/>

                <!-- 自定义 EQ -->
                <Expander Style="{StaticResource Fold}" IsExpanded="True" Margin="0,10,0,0"
                          Header="自定义 EQ" Tag="9 段">
                    <StackPanel Margin="0,4,0,0" Visibility="{Binding EqVisibility}">
                        <ItemsControl ItemsSource="{Binding Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="34" Margin="1">
                                        <TextBlock Text="{Binding GainText}" FontSize="10.5" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Text2Brush}"/>
                                        <Slider Style="{StaticResource VSlider}" Height="118" Margin="0,4"
                                                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                Value="{Binding GainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding FreqLabel}" FontSize="10.5" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Text2Brush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="单位 Hz · 步进 0.5dB（增益码表以 Phase 0 校准为准）" FontSize="10.5"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- 声学调校（M2） -->
                <Expander Style="{StaticResource Fold}" IsExpanded="True" Margin="0,8,0,0" Header="声学调校">
                    <Expander.Tag>
                        <Border Background="#33D7A013" CornerRadius="999" Padding="6,1">
                            <TextBlock Text="M2" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                        </Border>
                    </Expander.Tag>
                    <StackPanel Margin="0,4,0,0" Visibility="{Binding AcousticVisibility}">
                        <Grid>
                            <TextBlock Text="低频切除" FontSize="12" Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Text="{Binding LowCutoffHz, StringFormat={}{0:0}Hz}" FontSize="12"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                        <Slider x:Name="AcousticSlider" Style="{StaticResource HSlider}" Margin="0,4"
                                Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding LowCutoffHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="滚降斜率（dB/Oct）" FontSize="11" Foreground="{DynamicResource Text2Brush}" Margin="0,8,0,4"/>
                        <ListBox Style="{StaticResource SegmentListBox}" ItemsSource="{Binding SlopeOptions}"
                                 SelectedIndex="{Binding SlopeIndex, Mode=TwoWay}"/>

                        <TextBlock Text="空间声学（dB）" FontSize="11" Foreground="{DynamicResource Text2Brush}" Margin="0,10,0,4"/>
                        <ListBox Style="{StaticResource SegmentListBox}" ItemsSource="{Binding SpaceOptions}"
                                 SelectedIndex="{Binding SpaceIndex, Mode=TwoWay}"/>

                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="桌面反射控制" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding DesktopOn, Mode=TwoWay}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Content="恢复默认" HorizontalAlignment="Right"
                                    Command="{Binding AcousticResetCommand}"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
